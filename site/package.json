{
  "name": "instagram-saved-archive-site",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "check": "astro check",
    "test": "vitest run src && node --test scripts/check-static-output.test.mjs",
    "test:e2e": "playwright test",
    "build": "astro build",
    "preview": "astro preview",
    "check:static": "node scripts/check-static-output.mjs",
    "format:check": "prettier --plugin=prettier-plugin-astro --check 'src/**/*.{ts,astro,css}' '*.{json,mjs,ts}'"
  },
  "dependencies": {
    "astro": "7.3.1"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@playwright/test": "1.63.0",
    "@types/node": "26.4.1",
    "jsdom": "30.0.1",
    "prettier": "3.9.6",
    "prettier-plugin-astro": "0.14.1",
    "typescript": "6.0.3",
    "vitest": "5.0.0"
  }
}
