---
import "../styles/global.css";
interface Props {
  title: string;
}
const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="description"
      content="A collection of saved posts, with credit to their original creators."
    />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#posts">Skip to saved posts</a>
    <slot />
  </body>
</html>
